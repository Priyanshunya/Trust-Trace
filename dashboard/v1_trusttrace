<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>TrustTrace | Edge Telemetry</title>
    <style>
        :root {
            --bg: #f5f6f8; --white: #fff; --ink: #202938; --muted: #778294; 
            --line: #e4e8ee; --blue: #2859b8; --green: #18794e; --radius: 10px;
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--ink); font: 13px/1.45 Inter, Arial, sans-serif; }
        button, input { font: inherit; }
        button { cursor: pointer; }
        
        .app { max-width: 1200px; margin: auto; padding: 0 26px; display: flex; flex-direction: column; min-height: 100vh; }
        .top { height: 66px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
        .brand { font-weight: 800; font-size: 18px; color: var(--blue); }
        
        .btn { border: 1px solid var(--line); background: #fff; border-radius: 7px; padding: 8px 12px; font-weight: 650; transition: 0.1s ease; }
        .btn:hover { background: #fafcff; border-color: #b9c7df; }
        .btn.primary { background: var(--blue); color: #fff; border: none; }
        .btn.primary:hover { background: #1e4696; }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }
        
        .grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; margin-top: 20px; }
        .panel { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; }
        
        .reading-large { font-size: 34px; font-weight: 800; letter-spacing: -1px; margin: 10px 0; color: var(--ink); }
        .metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }
        .metric-box { border: 1px solid var(--line); border-radius: 8px; padding: 10px; background: #fafbfc; }
        .metric-label { font-size: 10px; color: var(--muted); text-transform: uppercase; font-weight: 700; }
        .metric-value { font-size: 14px; font-weight: 700; margin-top: 4px; }
        
        .log-container { height: 260px; overflow-y: auto; font-family: 'Courier New', Courier, monospace; font-size: 11px; background: #1e1e1e; color: #4af626; padding: 12px; border-radius: 8px; }
        .log-entry { margin-bottom: 6px; border-bottom: 1px solid #333; padding-bottom: 6px; }
        .log-error { color: #ff5c5c; }
        
        .form-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
        .form-row label { font-size: 11px; font-weight: 600; width: 110px; color: var(--muted); text-transform: uppercase; }
        .form-row input { flex: 1; padding: 8px 12px; border: 1px solid var(--line); border-radius: 6px; outline: none; }
        .form-row input:focus { border-color: var(--blue); }
        
        .actions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 20px; margin-bottom: 20px; }
    </style>
</head>
<body>

<div class="app">
    <header class="top">
        <div class="brand">TrustTrace Edge UI</div>
        <div>
            <span id="statusText" style="margin-right: 15px; color: var(--muted); font-weight: 700;">Disconnected</span>
            <button class="btn primary" id="btnConnect">Connect Node</button>
        </div>
    </header>

    <div class="grid">
        <!-- Live Telemetry Stream -->
        <section class="panel">
            <h3 style="margin-top:0;">Hardware Telemetry</h3>
            <div style="color: var(--muted); font-size: 11px; text-transform: uppercase; font-weight: 700;">Live PUF Impedance</div>
            <div class="reading-large" id="valPufR">-- kΩ</div>
            
            <div class="metrics">
                <div class="metric-box">
                    <div class="metric-label">Temperature</div>
                    <div class="metric-value" id="valTemp">-- °C</div>
                </div>
                <div class="metric-box">
                    <div class="metric-label">Humidity</div>
                    <div class="metric-value" id="valHum">-- %</div>
                </div>
                <div class="metric-box">
                    <div class="metric-label">Ethylene (Analog)</div>
                    <div class="metric-value" id="valGas">-- Raw</div>
                </div>
                <div class="metric-box">
                    <div class="metric-label">Registered Packages</div>
                    <div class="metric-value" id="valPkgCount">0</div>
                </div>
            </div>
        </section>

        <!-- Audit Engine & Logs -->
        <section class="panel">
            <h3 style="margin-top:0;">Audit Engine</h3>
            
            <div class="form-row">
                <label>Package ID</label>
                <input type="text" id="crateId" placeholder="e.g. PKG-001" autocomplete="off">
            </div>
            <div class="form-row">
                <label>Threshold (kΩ)</label>
                <input type="number" id="thresholdVal" step="0.1" value="0.3">
            </div>

            <div class="actions-grid">
                <button class="btn" id="btnBaseline">Register Baseline (HW Btn 1)</button>
                <button class="btn" id="btnAudit">Audit Package (HW Btn 2)</button>
            </div>
            
            <div class="log-container" id="eventLog">
                <div class="log-entry">UI Initialized. Awaiting BLE connection...</div>
            </div>
        </section>
    </div>
</div>

<script>
    const SERVICE_UUID    = '19b10000-e8f2-537e-4f6c-d104768a1214';
    const TELEMETRY_UUID  = '19b10001-e8f2-537e-4f6c-d104768a1214';
    const ALERT_UUID      = '19b10002-e8f2-537e-4f6c-d104768a1214';

    let bleDevice = null;
    let latestPufR = 0;
    
    // Store baselines dynamically so we can test multiple packages sequentially
    const packageRegistry = {}; 

    const dom = {
        btnConnect: document.getElementById('btnConnect'),
        status: document.getElementById('statusText'),
        pufR: document.getElementById('valPufR'),
        temp: document.getElementById('valTemp'),
        hum: document.getElementById('valHum'),
        gas: document.getElementById('valGas'),
        pkgCount: document.getElementById('valPkgCount'),
        log: document.getElementById('eventLog'),
        crateId: document.getElementById('crateId'),
        threshold: document.getElementById('thresholdVal'),
        btnBase: document.getElementById('btnBaseline'),
        btnAudit: document.getElementById('btnAudit')
    };

    function addLog(msg, isError = false) {
        const time = new Date().toLocaleTimeString('en-US', { hour12: false });
        const cssClass = isError ? 'log-entry log-error' : 'log-entry';
        dom.log.innerHTML = `<div class="${cssClass}">[${time}] ${msg}</div>` + dom.log.innerHTML;
    }

    async function connectBLE() {
        if (bleDevice && bleDevice.gatt.connected) {
            bleDevice.gatt.disconnect();
            return;
        }

        try {
            addLog("Scanning for TrustTrace nodes...");
            bleDevice = await navigator.bluetooth.requestDevice({
                filters: [{ namePrefix: 'TrustTrace' }],
                optionalServices: [SERVICE_UUID]
            });

            bleDevice.addEventListener('gattserverdisconnected', () => {
                dom.status.innerText = "Disconnected";
                dom.status.style.color = "var(--red)";
                dom.btnConnect.innerText = "Connect Node";
                addLog("Link lost. Node disconnected.", true);
            });

            const server = await bleDevice.gatt.connect();
            const service = await server.getPrimaryService(SERVICE_UUID);

            const telChar = await service.getCharacteristic(TELEMETRY_UUID);
            await telChar.startNotifications();
            telChar.addEventListener('characteristicvaluechanged', handleTelemetry);

            const alertChar = await service.getCharacteristic(ALERT_UUID);
            await alertChar.startNotifications();
            alertChar.addEventListener('characteristicvaluechanged', handleAlerts);

            dom.status.innerText = "Connected";
            dom.status.style.color = "var(--green)";
            dom.btnConnect.innerText = "Disconnect";
            addLog("Success: Telemetry pipes mapped to UI.");
            
        } catch (error) {
            addLog(`Bluetooth Error: ${error.message}`, true);
        }
    }

    function handleTelemetry(event) {
        const rawJson = new TextDecoder('utf-8').decode(event.target.value);
        try {
            const data = JSON.parse(rawJson);
            latestPufR = data.pufR;
            
            dom.pufR.innerText = `${data.pufR.toFixed(1)} kΩ`;
            dom.temp.innerText = `${data.temp.toFixed(1)} °C`;
            dom.hum.innerText  = `${data.hum.toFixed(1)} %`;
            dom.gas.innerText  = `${data.gas}`;
        } catch (e) {
            console.warn("Dropped malformed packet");
        }
    }

    function handleAlerts(event) {
        const msg = new TextDecoder('utf-8').decode(event.target.value).trim();
        if (msg === "BTN_1_PRESSED") {
            registerBaseline();
        } else if (msg === "BTN_2_PRESSED") {
            runAudit();
        }
    }

    function registerBaseline() {
        const id = dom.crateId.value.trim();
        if (!id) {
            addLog("Action Blocked: Enter a Package ID first.", true);
            return;
        }
        if (latestPufR === 0) {
            addLog("Action Blocked: No PUF signal detected.", true);
            return;
        }

        packageRegistry[id] = latestPufR;
        dom.pkgCount.innerText = Object.keys(packageRegistry).length;
        addLog(`SECURED: [${id}] baseline set to ${latestPufR.toFixed(1)} kΩ`);
    }

    function runAudit() {
        const id = dom.crateId.value.trim();
        if (!id) {
            addLog("Action Blocked: Enter a Package ID first.", true);
            return;
        }

        const baseline = packageRegistry[id];
        if (baseline === undefined) {
            addLog(`Audit Failed: [${id}] is not registered in the system.`, true);
            return;
        }

        const currentThreshold = parseFloat(dom.threshold.value) || 0.3;
        const diff = Math.abs(latestPufR - baseline);
        
        if (diff > currentThreshold) {
            addLog(`⚠️ BREACH: [${id}] drifted by ${diff.toFixed(2)} kΩ! Threshold was ${currentThreshold}.`, true);
        } else {
            addLog(`✅ VERIFIED: [${id}] is intact. Variance: ${diff.toFixed(2)} kΩ.`);
        }
    }

    // Attach listeners
    dom.btnConnect.addEventListener('click', connectBLE);
    dom.btnBase.addEventListener('click', registerBaseline);
    dom.btnAudit.addEventListener('click', runAudit);
</script>
</body>
</html>
